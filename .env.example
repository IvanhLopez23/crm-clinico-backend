NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Runtime: rol sin privilegios, sujeto a RLS
DATABASE_URL=postgres://crm_app:crm_app@localhost:5433/crm
# Migraciones: superusuario (owner de las tablas)
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5433/crm
# Worker de recordatorios: rol con BYPASSRLS (solo proceso de sistema)
WORKER_DATABASE_URL=postgres://crm_worker:crm_worker@localhost:5433/crm
WORKER_INTERVAL_MS=30000
# Minimo 32 caracteres. En produccion, generarla con `openssl rand -base64 48`.
AUTH_SECRET=dev-secret-change-me-0123456789abcdef
AUTH_TOKEN_TTL=8h
# Bootstrap del superadmin de plataforma (solo si no existe; no cambia contrasenas)
PLATFORM_ADMIN_BOOTSTRAP=true
PLATFORM_ADMIN_EMAIL=plataforma@demo.local
PLATFORM_ADMIN_PASSWORD=PasswordSegura123
PLATFORM_ADMIN_NAME=Administrador de plataforma
# Claves de PHI (32 bytes base64/hex). En produccion son obligatorias.
# PHI_ENCRYPTION_KEY=
# PHI_INDEX_KEY=
